{
  "name": "civolution",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "import": "pnpm --filter @civolution/importer run import",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/client/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "sim": "pnpm --filter @civolution/sim run sim --",
    "rules:curate": "pnpm --filter @civolution/rules run curate",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "dev": "pnpm --filter @civolution/client run dev",
    "build": "pnpm --filter @civolution/client run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
